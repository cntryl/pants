<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Cntryl.Pants.Destroyer</AssemblyName>
    <RootNamespace>Cntryl.Pants.Destroyer</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The test SDK auto-generates its own Main for the self-host test
         platform; our own top-level Main (the destroyer worker entry point)
         replaces it. dotnet test does not depend on this Main - it hosts
         the test classes via VSTest reflection. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pants\Pants.csproj"/>
  </ItemGroup>

</Project>
